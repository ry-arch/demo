<Window x:Class="ChitaiGorod.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ЧитайГород"
        Height="550"
        Width="900"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="White"
        FontFamily="Comic Sans MS"
        Icon="/Resources/icon.ico">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <!-- Левая часть -->

        <Border Grid.Column="0"
                Background="#ABCFCE">

            <StackPanel VerticalAlignment="Center">

                <Image Source="/icon.png"
                       Width="406"
                       Height="250"
                       Stretch="Uniform" RenderTransformOrigin="0.347,-0.099"
                       />

                <TextBlock Text="Книжный магазин"
                           FontSize="24"
                           FontWeight="Bold"
                           HorizontalAlignment="Center" Height="105"/>

            </StackPanel>

        </Border>

        <!-- Правая часть -->

        <Grid Grid.Column="1">

            <Border Width="350"
                    Height="374"
                    Background="White"
                    BorderBrush="#546F94"
                    BorderThickness="2"
                    CornerRadius="15"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <StackPanel Margin="30">

                    <TextBlock Text="Авторизация"
                               FontSize="28"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,30"/>

                    <TextBlock Text="Логин"/>

                    <TextBox x:Name="LoginBox"
                             Height="35"
                             Margin="0,5,0,15"/>

                    <TextBlock Text="Пароль"/>

                    <PasswordBox x:Name="PasswordBox"
                                 Height="35"
                                 Margin="0,5,0,25"/>

                    <Button x:Name="LoginButton"
                            Content="Войти"
                            Height="40"
                            Background="#546F94"
                            Foreground="White"
                            FontWeight="Bold"
                            Click="LoginButton_Click"/>

                    <Button x:Name="GuestButton"
                            Content="Войти как гость"
                            Height="40"
                            Margin="0,10,0,0"
                            Background="#ABCFCE"
                            Click="GuestButton_Click"/>

                </StackPanel>

            </Border>

        </Grid>

    </Grid>

</Window>
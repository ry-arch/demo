<Window x:Class="kakto.OrderEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактирование заказа"
        Height="500"
        Width="600"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        
        

        <TextBlock Text="Артикул"/>

        <TextBox x:Name="ArticleBox"
                 Grid.Row="1"
                 Margin="0,5,0,10"/>

        <TextBlock Grid.Row="2"
                   Text="Статус заказа"/>

        <ComboBox x:Name="StatusBox"
                  Grid.Row="3"
                  Margin="0,5,0,10"/>

        <TextBlock Grid.Row="4"
                   Text="Пункт выдачи"/>

        <ComboBox x:Name="PickupBox"
                  Grid.Row="5"
                  Margin="0,5,0,10"/>

        <StackPanel Grid.Row="6">

            <TextBlock Text="Дата заказа"/>

            <DatePicker x:Name="OrderDatePicker"
            SelectedDateChanged="OrderDatePicker_SelectedDateChanged"/>

            <TextBlock Margin="0,10,0,0"
                       Text="Дата выдачи"/>

            <DatePicker x:Name="DeliveryDatePicker"/>

            <Button Content="Сохранить"
                    Height="35"
                    Margin="0,20,0,0"
                    Click="Save_Click"/>

        </StackPanel>

    </Grid>

</Window>
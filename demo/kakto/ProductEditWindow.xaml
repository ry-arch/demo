<Window x:Class="kakto.ProductEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавление / редактирование товара"
        Height="750"
        Width="900"
        WindowStartupLocation="CenterScreen">

    <ScrollViewer>

        <Grid Margin="20">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Фото -->

            <StackPanel Grid.Column="0">

                <Image x:Name="PhotoImage"
                       Width="300"
                       Height="200"
                       Stretch="Uniform"/>

                <Button Content="Выбрать фото"
                        Margin="0,10,0,0"
                        Click="ChoosePhoto_Click"/>

            </StackPanel>

            <!-- Данные -->

            <StackPanel Grid.Column="1"
                        Margin="20,0,0,0">

                <TextBlock Text="Артикул"/>

                <TextBox x:Name="ArticleBox"
                         IsReadOnly="True"/>

                <TextBlock Text="Наименование товара"
                           Margin="0,10,0,0"/>

                <TextBox x:Name="NameBox"/>

                <TextBlock Text="Категория"
                           Margin="0,10,0,0"/>

                <ComboBox x:Name="CategoryBox"/>

                <TextBlock Text="Издательство"
                           Margin="0,10,0,0"/>

                <ComboBox x:Name="ManufacturerBox"/>

                <TextBlock Text="Автор"
                           Margin="0,10,0,0"/>
                
                

                <ComboBox x:Name="UnitBox"/>
                <TextBlock Text="Единица измерения"
Margin="0,10,0,0"/>

                <ComboBox x:Name="SupplierBox"/>

                <TextBlock Text="Цена"
                           Margin="0,10,0,0"/>

                <TextBox x:Name="PriceBox"/>

                <TextBlock Text="Количество"
                           Margin="0,10,0,0"/>

                <TextBox x:Name="QuantityBox"/>

                <TextBlock Text="Скидка (%)"
                           Margin="0,10,0,0"/>

                <TextBox x:Name="DiscountBox"/>

                <TextBlock Text="Описание"
                           Margin="0,10,0,0"/>

                <TextBox x:Name="DescriptionBox"
                         Height="120"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"/>

                <Button Content="Сохранить"
                        Height="40"
                        Margin="0,20,0,0"
                        Click="Save_Click"/>
                <Button Content="Назад"
        Height="40"
        Margin="0,10,0,0"
        Click="Back_Click"/>

            </StackPanel>

        </Grid>

    </ScrollViewer>

</Window>